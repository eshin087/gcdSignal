# ── YouTube (optional, enables per-category video search) ───────────────────
# Free Google Cloud API key: create a project at console.cloud.google.com,
# enable "YouTube Data API v3", create an API key. Without it the YouTube
# column falls back to curated AI channels via keyless RSS (still shows views).
YOUTUBE_API_KEY=

# ── Reddit (optional; scores come from HTML scraping without it) ────────────
# Existing OAuth credentials take priority over best-effort public fallbacks.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Bluesky (optional credentials, preferred when configured) ──────────────
# Use an app password, not your account password. Public AppViews are fallback.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
